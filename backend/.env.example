# Copy this file to .env and fill in values for your environment.
# The defaults below match the docker-compose.yml credentials — no changes needed for local dev.

POSTGRES_URL=postgresql+asyncpg://shopforge:shopforge_pass@localhost:5433/shopforge
MONGO_URL=mongodb://shopforge:shopforge_pass@localhost:27018/shopforge?authSource=admin
MONGO_DB_NAME=shopforge
